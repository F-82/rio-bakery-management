# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server only. Never expose to the client.
# Used by server actions/RPC and the tests/db suite (service role bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for the SQL test suite (tests/db), staging only.
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
